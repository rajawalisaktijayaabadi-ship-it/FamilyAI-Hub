{
  "entities": {
    "User": {
      "title": "User",
      "description": "Family member user profile entity",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "parent", "child", "grandparent", "guest"] },
        "familyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "isOnline": { "type": "boolean" }
      },
      "required": ["uid", "email", "displayName", "role", "familyId"]
    },
    "Family": {
      "title": "Family",
      "description": "Family group collection entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "familyName": { "type": "string" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "familyName", "ownerUid"]
    },
    "Child": {
      "title": "Child",
      "description": "Child profile entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "birthDate": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "school": { "type": "string" },
        "grade": { "type": "string" },
        "bloodType": { "type": "string" }
      },
      "required": ["id", "familyId", "name", "age"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection storing family app users"
    },
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/Family" },
      "description": "Collection storing family units"
    },
    "/children/{childId}": {
      "schema": { "$ref": "#/entities/Child" },
      "description": "Collection storing children profiles"
    },
    "/child_profile/{childId}": {
      "description": "Extended child profiles collection"
    },
    "/child_growth/{growthId}": {
      "description": "Child physical and development growth records"
    },
    "/child_milestone/{milestoneId}": {
      "description": "Child development milestone tracking"
    },
    "/daily_activity/{activityId}": {
      "description": "Daily logged activities for child"
    },
    "/habit_tracker/{habitId}": {
      "description": "Habits and streak tracking for child"
    },
    "/reward_system/{childId}": {
      "description": "Points, coins, and badges for child"
